{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GuideCatalogSchema",
  "type": "object",
  "required": ["version", "lastUpdated", "guides"],
  "properties": {
    "version": { "type": "string" },
    "lastUpdated": { "type": "string", "format": "date-time" },
    "guides": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "slug", "title", "summary", "mdFilename", "hasSvg", "tags"],
        "properties": {
          "id": { "type": "string", "pattern": "^[0-9]{2}$" },
          "type": { "type": "string", "enum": ["CHEATSHEET", "TUTORIAL", "PROCEDIMIENTO", "REFERENCIA"] },
          "slug": { "type": "string" },
          "title": { "type": "string" },
          "summary": { "type": "string" },
          "mdFilename": { "type": "string" },
          "svgFilename": { "type": "string" },
          "hasSvg": { "type": "boolean" },
          "tags": { "type": "array", "items": { "type": "string" } },
          "contentMarkdown": { "type": "string" }
        }
      }
    }
  }
}
